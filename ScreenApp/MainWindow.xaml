<Window x:Class="ScreenApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScreenApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        d:DataContext="{d:DesignInstance Type=local:MainWindow, IsDesignTimeCreatable=True}">

    
    <Grid>
        <StackPanel >
            <Button Click="Button_Click" Height="20" Content="Swap"/>

            <ContentPresenter Content="{Binding Screen}">
                <ContentPresenter.Resources>
                    <DataTemplate DataType="{x:Type local:A}">
                        <Rectangle Fill="LightBlue" Width="200" Height="100" Margin="10"/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type local:B}">
                        <Ellipse Fill="Orange" Width="200" Height="200" Margin="10" />
                    </DataTemplate>
                </ContentPresenter.Resources>
             </ContentPresenter>



        </StackPanel>
    </Grid>
</Window>
