<Window x:Class="Temp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Temp"
        mc:Ignorable="d"
        Title="WPF ItemContainerStyle Demo" Height="450" Width="800">

    <Window.Resources>
        <ControlTemplate x:Key="myButtonTemplate" TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}">
                <ContentPresenter />
            </Border>

            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <!-- Bind to your clean custom attached property -->
                    <Setter TargetName="ButtonBorder" Property="Background" 
                            Value="{TemplateBinding local:ButtonHelper.HoverBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300" >

            <TextBlock Text="Press 'TAB' key to switch focus:" 
                       HorizontalAlignment="Center" 
                       FontWeight="Bold" Margin="0,0,0,10"/>
            
            <Button Template="{StaticResource MyButtonTemplate}"
                    Background="AliceBlue"
                    local:ButtonHelper.HoverBrush="LimeGreen" 
                    Content="Custom Hover Button" />

            <Button Content="Custom Focus (Blue Ring)"  Height="50" Background="White" Margin="10"
                    FocusVisualStyle="{StaticResource MyCustomFocusStyle}"/>

            <Button Content="No Focus Visual Style"  Height="50" Background="White" Margin="10"
                    FocusVisualStyle="{x:Null}"/>

        </StackPanel>
    </Grid>
</Window>