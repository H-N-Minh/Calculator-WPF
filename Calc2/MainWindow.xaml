<Window x:Class="Calc2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calc2"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="400"
        Background="LightGray"
        d:DataContext="{d:DesignInstance Type=local:Calculator,IsDesignTimeCreatable=True}">
    <Grid Margin="0,0,0,-6">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="6" Background="White" Margin="10" FontSize="40" TextAlignment="Right"
                   Text="{Binding Display}"/>

        <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="Backspace" Command="{Binding CommandHandler}" CommandParameter="BackSpace"/>
        <Button Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Content="CE" Command="{Binding CommandHandler}" CommandParameter="CE"/>
        <Button Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" Content="C" Command="{Binding CommandHandler}" CommandParameter="C"/>

        <Button Grid.Row="2" Grid.Column="0" Content="MC"/>
        <Button Grid.Row="2" Grid.Column="1" Content="7" Command="{Binding CommandHandler}" CommandParameter="7"/>
        <Button Grid.Row="2" Grid.Column="2" Content="8" Command="{Binding CommandHandler}" CommandParameter="8"/>
        <Button Grid.Row="2" Grid.Column="3" Content="9" Command="{Binding CommandHandler}" CommandParameter="9"/>
        <Button Grid.Row="2" Grid.Column="4" Content="/" Command="{Binding CommandHandler}" CommandParameter="/"/>
        <Button Grid.Row="2" Grid.Column="5" Content="sqrt"/>

        <Button Grid.Row="3" Grid.Column="0" Content="MR"/>
        <Button Grid.Row="3" Grid.Column="1" Content="4" Command="{Binding CommandHandler}" CommandParameter="4"/>
        <Button Grid.Row="3" Grid.Column="2" Content="5" Command="{Binding CommandHandler}" CommandParameter="5"/>
        <Button Grid.Row="3" Grid.Column="3" Content="6" Command="{Binding CommandHandler}" CommandParameter="6"/>
        <Button Grid.Row="3" Grid.Column="4" Content="*" Command="{Binding CommandHandler}" CommandParameter="*"/>
        <Button Grid.Row="3" Grid.Column="5" Content="%"/>

        <Button Grid.Row="4" Grid.Column="0" Content="MS"/>
        <Button Grid.Row="4" Grid.Column="1" Content="1" Command="{Binding CommandHandler}" CommandParameter="1"/>
        <Button Grid.Row="4" Grid.Column="2" Content="2" Command="{Binding CommandHandler}" CommandParameter="2"/>
        <Button Grid.Row="4" Grid.Column="3" Content="3" Command="{Binding CommandHandler}" CommandParameter="3"/>
        <Button Grid.Row="4" Grid.Column="4" Content="-" Command="{Binding CommandHandler}" CommandParameter="-"/>
        <Button Grid.Row="4" Grid.Column="5" Content="1/x"/>

        <Button Grid.Row="5" Grid.Column="0" Content="M+"/>
        <Button Grid.Row="5" Grid.Column="1" Content="0" Command="{Binding CommandHandler}" CommandParameter="0"/>
        <Button Grid.Row="5" Grid.Column="2" Content="+/-" Command="{Binding CommandHandler}" CommandParameter="+/-"/>
        <Button Grid.Row="5" Grid.Column="3" Content="," Command="{Binding CommandHandler}" CommandParameter=","/>
        <Button Grid.Row="5" Grid.Column="4" Content="+" Command="{Binding CommandHandler}" CommandParameter="+"/>
        <Button Grid.Row="5" Grid.Column="5" Content="=" Command="{Binding CommandHandler}" CommandParameter="="/>

    </Grid>
</Window>
