<UserControl x:Class="SDK.Views.BookDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SDK.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BookDetailViewModel}">


    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Name -->
        <TextBlock Text="Name:" FontWeight="Bold" />
        <TextBox Grid.Row="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 IsReadOnly="{Binding IsViewMode}" Margin="0,5" />

        <!-- Author -->
        <TextBlock Grid.Row="1" Text="Author:" FontWeight="Bold" />
        <TextBox Grid.Row="1" Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}"
                 IsReadOnly="{Binding IsViewMode}" Margin="0,5" />

        <!-- Publication Date -->
        <TextBlock Grid.Row="2" Text="Publication Date:" FontWeight="Bold" />
        <TextBox Grid.Row="2" Text="{Binding PublicationDate, UpdateSourceTrigger=PropertyChanged}"
                 IsReadOnly="{Binding IsViewMode}" Margin="0,5" />

        <!-- Pages -->
        <TextBlock Grid.Row="3" Text="Pages:" FontWeight="Bold" />
        <TextBox Grid.Row="3" Text="{Binding Pages, UpdateSourceTrigger=PropertyChanged}"
                 IsReadOnly="{Binding IsViewMode}" Margin="0,5" />

        <!-- Price -->
        <TextBlock Grid.Row="4" Text="Price:" FontWeight="Bold" />
        <TextBox Grid.Row="4" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                 IsReadOnly="{Binding IsViewMode}" Margin="0,5" />

        <!-- Rating -->
        <TextBlock Grid.Row="5" Text="Rating:" FontWeight="Bold" />
        <TextBox Grid.Row="5" Text="{Binding Rating, UpdateSourceTrigger=PropertyChanged}"
                 IsReadOnly="{Binding IsViewMode}" Margin="0,5" />

        <!-- Description -->
        <TextBlock Grid.Row="6" Text="Description:" FontWeight="Bold" />
        <TextBox Grid.Row="6" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 IsReadOnly="{Binding IsViewMode}" TextWrapping="Wrap" Height="60" Margin="0,5" />

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Command="{Binding SaveCommand}" Width="60" Margin="5,0"
                    Visibility="{Binding IsEditOrAddMode, Converter={StaticResource BoolToVis}}" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" Width="60" Margin="5,0"
                    Visibility="{Binding IsEditOrAddMode, Converter={StaticResource BoolToVis}}" />
            <Button Content="Back" Command="{Binding BackCommand}" Width="60" Margin="5,0"
                    Visibility="{Binding IsViewMode, Converter={StaticResource BoolToVis}}" />
            <Button Content="Edit" Command="{Binding EditCommand}" Width="60" Margin="5,0"
                    Visibility="{Binding IsViewMode, Converter={StaticResource BoolToVis}}" />
            <Button Content="Delete" Command="{Binding DeleteCommand}" Width="60" Margin="5,0"
                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}" Foreground="Red" />
        </StackPanel>
    </Grid>
</UserControl>