<Window x:Class="SDK.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SDK.ViewModels"
        xmlns:v="clr-namespace:SDK.Views"
        Title="Book Library" Height="500" Width="900">

    <Window.DataContext>
        <vm:AppViewModel />
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MainListViewModel}">
            <v:MainListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BookDetailViewModel}">
            <v:BookDetailView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- Search Bar -->
        <Border Grid.Row="0" Padding="10" Background="#F0F0F0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="X" Width="30"
                        Command="{Binding ClearSearchCommand}" />
                <Button DockPanel.Dock="Right" Content="Search" Margin="5,0"
                        Command="{Binding SearchCommand}" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"
                         x:Name="SearchBox"
                         KeyDown="SearchBox_KeyDown">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Background" Value="White" />
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="#FFF5F5F5" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                    <TextBox.Resources>
                        <VisualBrush x:Key="PlaceholderBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                            <VisualBrush.Visual>
                                <TextBlock Text="Search by book names or Author.." Foreground="Gray" FontStyle="Italic" />
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </TextBox.Resources>
                    <TextBox.Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Background" Value="{StaticResource PlaceholderBrush}" />
                        </Trigger>
                    </TextBox.Style.Triggers>
                </TextBox>
            </DockPanel>
        </Border>

        <!-- Content area -->
        <ContentPresenter Grid.Row="1" Content="{Binding Screen}" />
    </Grid>
</Window>