<UserControl x:Class="YT.InputBox.InputBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:YT.InputBox"
             mc:Ignorable="d" 
             d:DesignWidth="500">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="40"/>
        </Grid.ColumnDefinitions>
        <!--<Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        -->

        <TextBlock Grid.Row="1" Grid.RowSpan="3" FontSize="20" Text="{Binding BlockText}" VerticalAlignment="Center" 
                   Background="LightBlue" Padding="0"/>
        <TextBox Grid.RowSpan="3" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" FontSize="20"
                 Background="Transparent" />
        <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Content="x" Foreground="Gray"
                 BorderThickness="0" Click="Button_Click" />
    </Grid>
</UserControl>
