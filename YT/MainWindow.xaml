<Window x:Class="YT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:YT"
        xmlns:InputBox="clr-namespace:YT.InputBox"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:DataForMainWindow}"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

         
        <InputBox:InputBox x:Name="_inputBox" Background="Orange" DataContext="{Binding DataInputBox}"/>
        <Button Grid.Row="1" Width="60" Height="30" Content="Set"/>
        <TextBlock Grid.Row="2" Text="{Binding  }" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="30"/>

    </Grid>
</Window>
