<UserControl x:Class="Library.Views.BookDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Library.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="Back" Command="{Binding ReturnToListView}" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <StackPanel Margin="20" Grid.Row="1" DataContext="{Binding Book}">
            <StackPanel Orientation="Horizontal">
                <Label Content="Title:" Target="{Binding ElementName=titleBlock}" FontSize="20" VerticalContentAlignment="Center"/>
                <TextBlock x:Name="titleBlock" Text="{Binding Title, TargetNullValue='(unknown)'}" FontSize="20" FontWeight="Bold" BaselineOffset="0"/>
            </StackPanel>
            <TextBlock Text="{Binding Author, StringFormat='Author: {0}', TargetNullValue='Author: (unknown)'}" FontSize="20"/>
            <TextBlock Text="{Binding PublishDate, StringFormat='Publish Date: {0:d}', TargetNullValue='Publish Date: (unknown)'}" FontSize="20"/>
            <TextBlock Text="{Binding Pages, StringFormat='Pages: {0}', TargetNullValue='Pages: (unknown)'}" FontSize="20"/>
            <TextBlock Text="{Binding Price, StringFormat='Price: {0:C}', TargetNullValue='Price: (unknown)'}" FontSize="20"/>
            <TextBlock Text="{Binding Rating, StringFormat='Rating: {0}', TargetNullValue='Rating: (unknown)'}" FontSize="20"/>
            <TextBlock Text="{Binding Description, StringFormat='Description: {0}', TargetNullValue='Description: (unknown)'}" FontSize="20" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
