<Window x:Class="Library.Views.AddBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Library.Views"
        mc:Ignorable="d"
        Title="AddBookWindow" Height="700" Width="600"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <ScrollViewer>

            <StackPanel>
                <TextBlock Text="Title*:" Margin="10,15,10,5" FontSize="18"/>
                <TextBox Margin="10,0,10,0" FontSize="20"/>
                <TextBlock Text="Author:" Margin="10,15,10,5" FontSize="18"/>
                <TextBox Margin="10,0,10,0" FontSize="20"/>
                <TextBlock Text="Published on:" Margin="10,15,10,5" FontSize="18"/>
                <TextBox Margin="10,0,10,0" FontSize="20"/>
                <TextBlock Text="Page count:" Margin="10,15,10,5" FontSize="18"/>
                <TextBox Margin="10,0,10,0" FontSize="20"/>
                <TextBlock Text="Price:" Margin="10,15,10,5" FontSize="18"/>
                <TextBox Margin="10,0,10,0" FontSize="20"/>
                <TextBlock Text="Rating:" Margin="10,15,10,5" FontSize="18"/>
                <TextBox Margin="10,0,10,0" FontSize="20"/>
                <TextBlock Text="Description:" Margin="10,15,10,5" FontSize="18"/>
                <TextBox Margin="10,0,10,0" FontSize="20" TextWrapping="Wrap"/>

                <Grid Margin="10,20,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancel" Margin="5" Padding="10,5" HorizontalAlignment="Right"/>
                    <Button Grid.Column="1" Content="Add Book" Margin="5" Padding="10,5" HorizontalAlignment="Left"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        
    </Grid>
</Window>
