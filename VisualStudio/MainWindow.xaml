<Window x:Class="VisualStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VisualStudio"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <DockPanel>
        <Menu DockPanel.Dock="Top" Height="20" Background="Gray">
            <Button Content="File" Margin="5,0"/>
            <Button Content="Edit" Margin="5,0"/>
            <Button Content="View" Margin="5,0"/>
        </Menu>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Background="LightSlateGray">
            <StackPanel.LayoutTransform>
                <RotateTransform Angle="90"/>
            </StackPanel.LayoutTransform>
            
            <!--Right side buttons-->
            <Button x:Name="SEButton" Content="Solution Explorer" Margin="5,0" MouseEnter="SEButton_MouseEnter" MouseLeave="SEButton_MouseLeave" Click="SEButton_Click"/>
            <Button x:Name="PropertiesButton" Content="Properties" Margin="5,0" MouseEnter="PropertiesButton_MouseEnter" MouseLeave="PropertiesButton_MouseLeave" Click="PropertiesButton_Click"/>
        </StackPanel>
        
        <!--Main window content-->
        <Grid Grid.IsSharedSizeScope="True">
            <!--Layer 0-->
            <Grid x:Name="Layer0Panel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="Content 1" Background="Beige" Width="100" Height="40" TextAlignment="Center" Margin="5"/>
                    <TextBlock Text="Content 2" Background="Beige" Width="100" Height="40" TextAlignment="Center" Margin="5"/>
                    <TextBlock Text="Content 3" Background="Beige" Width="100" Height="40" TextAlignment="Center" Margin="5"/>
                    <TextBlock Text="Content 4" Background="Beige" Width="100" Height="40" TextAlignment="Center" Margin="5"/>
                    <TextBlock Text="Content 5" Background="Beige" Width="100" Height="40" TextAlignment="Center" Margin="5"/>
                    <TextBlock Text="Content 6" Background="Beige" Width="100" Height="40" TextAlignment="Center" Margin="5"/>
                    <TextBlock Text="Content 7" Background="Beige" Width="100" Height="40" TextAlignment="Center" Margin="5"/>
                    <TextBlock Text="Content 8" Background="Beige" Width="100" Height="40" TextAlignment="Center" Margin="5"/>
                    <TextBlock Text="Content 9" Background="Beige" Width="100" Height="40" TextAlignment="Center" Margin="5"/>
                </WrapPanel>
            </Grid>

            <!--Layer 1-->
            <Grid Visibility="Collapsed" x:Name="SEPanel" MouseEnter="SEPanel_MouseEnter" MouseLeave="SEPanel_MouseLeave">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PanelSEWidth"/>
                </Grid.ColumnDefinitions>
                
                <Rectangle Grid.Column="1" Fill="LightBlue"/>
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Left" Background="DarkBlue" />
                
                <StackPanel Grid.Column="1">
                    <Button x:Name="SEPinButton" Content="Pin/Unpin this panel" Width="150" Margin="5" Click="SEPinButton_Click"/>
                    <TextBlock Text="Solution Explorer content goes here" Margin="10" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
            
            <!--Layer 2-->
            <Grid Visibility="Collapsed" x:Name="PropertiesPanel" MouseEnter="PropertiesPanel_MouseEnter" MouseLeave="PropertiesPanel_MouseLeave">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="PanelPropertiesWidth"/>
                </Grid.ColumnDefinitions>
                
                <Rectangle Grid.Column="1" Fill="Orange"/>
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Left" Background="DarkOrange" />
                <StackPanel Grid.Column="1">
                    <Button x:Name="PropertyPinButton" Content="Pin/Unpin this panel" Width="150" Margin="5" Click="PropertyPinButton_Click"/>
                    <TextBlock Text="Properties content goes here" Margin="10" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>
        

    </DockPanel>
</Window>
