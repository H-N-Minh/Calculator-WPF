<UserControl x:Class="PriorityTaskBoard.Controls.SingleEntry"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="ParentBadge">
    <Grid Margin="5,5,5,5" Width="520">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <CheckBox Grid.Column="0" x:Name="MyCheckBox"
                                  VerticalAlignment="Center" Margin="0,0,10,0"/>

        <TextBlock Grid.Column="1" 
                                   x:Name="MyTextBlock"
                                   Foreground="{DynamicResource PrimaryText}" 
                                   VerticalAlignment="Center" FontSize="14"/>

        <Border x:Name="BadgeBorder" CornerRadius="5" Padding="8,4" MinWidth="60" Grid.Column="2">
            <TextBlock x:Name="BadgeText" 
                   Foreground="White" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"/>
        </Border>
    </Grid>

</UserControl>
