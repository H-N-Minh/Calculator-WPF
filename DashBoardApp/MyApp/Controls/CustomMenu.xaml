<UserControl x:Class="DashBoardApp.Controls.CustomMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DashBoardApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="20" d:DesignWidth="800"
             x:Name="MenuRoot">

    <Menu Grid.Row="0"
          DataContext="{Binding ElementName=MenuRoot}">
        <MenuItem Header="_File">
            <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
            <Separator/>
            <MenuItem Header="_Edit"/>
        </MenuItem>
        <MenuItem Header="_DummyMenu">
            <MenuItem Header="DummyMenu_2"/>
        </MenuItem>
    </Menu>
</UserControl>
