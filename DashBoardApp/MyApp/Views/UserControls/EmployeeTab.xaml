<UserControl x:Class="DashBoardApp.Views.UserControls.EmployeeTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DashBoardApp.Views.UserControls"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="EmployeeTabRoot">
    <Grid ColumnDefinitions="Auto, Auto, *">
        
        <!--Left side view-->
        <TreeView ItemsSource="{Binding AllDepartments}"
                  Grid.Column="0"
                  BorderThickness="1"
                  Padding="10"
                  Background="LightCyan"
                  x:Name="MyTreeView"
                  SelectedItemChanged="MyTreeView_SelectedItemChanged">
  
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding Name}" 
                               FontWeight="SemiBold"/>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <GridSplitter Grid.Column="1"
                      Width="5"
                      Background="Aquamarine"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"/>
        
        <!--Right side view-->
        <Grid Grid.Column="2"
              RowDefinitions="Auto, *">
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal">
                <TextBlock Text="Role: " Margin="5" FontWeight="Bold"/>
                <ComboBox IsEditable="False"
                          ItemsSource="{Binding VisibleRoles}"
                          SelectedItem="{Binding SelectedRole}"
                          DisplayMemberPath="Name"
                          MinWidth="200"/>
            </StackPanel>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding VisibleEmployees}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ></WrapPanel>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" 
                                BorderThickness="1" 
                                CornerRadius="5" 
                                Padding="10" 
                                Margin="5" 
                                Width="300" 
                                Background="LightYellow">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="Bold"
                                           Foreground="DarkBlue"
                                           FontSize="20"/>
                                <TextBlock FontStyle="Italic"
                                           Foreground="DarkGreen"
                                           FontSize="15">
                                    <Run Text="Role: "/>
                                    <Run Text="{Binding Role.Name}" FontWeight="DemiBold"/>
                                </TextBlock>

                                <TextBlock FontStyle="Italic"
                                           Foreground="DarkGreen"
                                           FontSize="15">
                                    <Run Text="Department: "/>
                                    <Run Text="{Binding Department.Name}" FontWeight="DemiBold"/>
                                </TextBlock>
                                
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
