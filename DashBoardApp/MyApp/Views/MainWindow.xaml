<Window x:Class="DashBoardApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DashBoardApp"
        xmlns:controls="clr-namespace:DashBoardApp.Controls"
        xmlns:userControls="clr-namespace:DashBoardApp.Views.UserControls"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="900"
        >

    <DockPanel>
        <controls:CustomMenu DockPanel.Dock="Top"
                             ExitCommand="{Binding ExitAppCommand}"/>
        
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Refresh"
                    Background="LightBlue"
                    Command="{Binding RefreshCommand}"/>
        </ToolBar>
        
        <controls:CustomStatusBar DockPanel.Dock="Bottom" 
                                  IsLoading="{Binding IsLoading}"/>

        <TabControl TabStripPlacement="Bottom">
            <TabItem Header="Employee">
            </TabItem>
            
            <TabItem Header="Inventory">
                <userControls:InventoryTab Margin="10"
                                           DataContext="{Binding InventoryViewModel}"/>
            </TabItem>

            <TabItem Header="Inventory (Editable)">
                <userControls:InventoryEditTab Margin="10"
                                               DataContext="{Binding InventoryViewModel}"/>
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
