<Window x:Class="DashBoardApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DashBoardApp"
        xmlns:vm="clr-namespace:DashBoardApp.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <!-- Bind the ViewModel directly in XAML -->
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Menu -->
            <RowDefinition Height="Auto"/>
            <!-- ToolBar -->
            <RowDefinition Height="*"/>
            <!-- Tabs -->
            <RowDefinition Height="Auto"/>
            <!-- StatusBar -->
        </Grid.RowDefinitions>

        <!-- 1. Menu -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
            </MenuItem>
        </Menu>

        <!-- 2. ToolBar -->
        <ToolBar Grid.Row="1">
            <Button Content="Refresh Data" Command="{Binding RefreshDataCommand}" Padding="5"/>
        </ToolBar>

        <!-- 3. TabControl -->
        <TabControl Grid.Row="2" Margin="5">

            <!-- TAB 1: Employee Directory -->
            <TabItem Header="Directory">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- TreeView (Hierarchical Data) -->
                    <TreeView Grid.Column="0" ItemsSource="{Binding Departments}" Margin="5">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <Grid Grid.Column="1" Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- ComboBox (SelectedValuePath / DisplayMemberPath) -->
                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Filter by Role: " VerticalAlignment="Center"/>
                            <ComboBox Width="150" 
                                      ItemsSource="{Binding Roles}" 
                                      DisplayMemberPath="Name" 
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedRoleId}"/>
                        </StackPanel>

                        <!-- ListBox (Custom WrapPanel ItemsPanel) -->
                        <ListBox Grid.Row="1" ItemsSource="{Binding FilteredEmployees}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <!-- Changing the layout from Vertical to wrapping Horizontal -->
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <!-- Defining the "ID Card" look -->
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="5" Width="140" Background="#F0F0F0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock Text="{Binding Department}" FontStyle="Italic" Foreground="DarkGray"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: Hardware Inventory -->
            <TabItem Header="Hardware Inventory">
                <!-- ListView with GridView for read-only columns -->
                <ListView ItemsSource="{Binding HardwareAssets}" Margin="5">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Asset ID" DisplayMemberBinding="{Binding AssetId}" Width="100"/>
                            <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Type}" Width="100"/>
                            <GridViewColumn Header="Manufacturer" DisplayMemberBinding="{Binding Manufacturer}" Width="120"/>
                            <GridViewColumn Header="Assigned To" DisplayMemberBinding="{Binding AssignedTo}" Width="150"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>

            <!-- TAB 3: Software Licenses -->
            <TabItem Header="Software Licenses">
                <!-- DataGrid for editable tabular data -->
                <DataGrid ItemsSource="{Binding SoftwareLicenses}" Margin="5" 
                          AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <!-- Read-only column -->
                        <DataGridTextColumn Header="Software" Binding="{Binding SoftwareName}" IsReadOnly="True" Width="150"/>
                        <!-- Editable columns -->
                        <DataGridTextColumn Header="License Key" Binding="{Binding LicenseKey}" Width="200"/>
                        <DataGridTextColumn Header="Expiration Date" Binding="{Binding ExpirationDate}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

        </TabControl>

        <!-- 4. StatusBar -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusBarText}" Width="150"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <!-- ProgressBar tied to async loading state -->
                <ProgressBar IsIndeterminate="{Binding IsLoading}" Width="100" Height="15"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
